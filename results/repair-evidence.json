    "case": "pi-duration-0",
    "final_source": "def duration(text):\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string\")\n\n    parts = text.split(':')\n    if len(parts) != 3:\n        raise ValueError(\"text must be exactly HH:MM:SS\")\n\n    digits = '0123456789'\n    hours = minutes = seconds = 0\n    for index, part in enumerate(parts):\n        if len(part) != 2 or part[0] not in digits or part[1] not in digits:\n            raise ValueError(\"each field must be exactly two ASCII digits\")\n        value = int(part)\n        if index == 0:\n            hours = value  # exactly two ASCII digits guarantees 00..99\n        elif index == 1:\n            if value > 59:\n                raise ValueError(\"minutes must be 00..59\")\n            minutes = value\n        else:\n            if value > 59:\n                raise ValueError(\"seconds must be 00..59\")\n            seconds = value\n\n    return hours * 3600 + minutes * 60 + seconds\n",
